#!/bin/zsh

set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin

readonly assets_dir="/Library/Application Support/BatteryGuard/InstallerAssets"
readonly dependency_dir="/usr/local/co.palokaj.battery"
readonly sudoers_dir="/private/etc/sudoers.d"
readonly sudoers_file="${sudoers_dir}/battery"
readonly expected_battery_hash="ce1917ba2176851bf6096f1a343ff9e1306c748e1ee2c5fbe9e37fa3cd45bf04"
readonly expected_smc_hash="e3b4392c966dee700f3e1d6cc3812c0d487954c3d6d77b91f521a9590aadae44"

fail() {
  print -u2 -- "BatteryGuard 설치 실패: $*"
  exit 1
}

verify_secure_root_directory() {
  local target_path="$1"
  [[ -d "$target_path" && ! -L "$target_path" ]] || fail "신뢰할 수 있는 디렉터리가 아닙니다: ${target_path}"
  [[ "$(stat -f '%u' "$target_path")" == "0" ]] || fail "root 소유 디렉터리가 아닙니다: ${target_path}"
  local mode
  mode="$(stat -f '%Lp' "$target_path")"
  (( (8#$mode & 8#22) == 0 )) || fail "그룹 또는 다른 사용자가 쓸 수 있는 디렉터리입니다: ${target_path}"
}

verify_secure_root_file() {
  local target_path="$1"
  [[ -f "$target_path" && ! -L "$target_path" ]] || fail "신뢰할 수 있는 일반 파일이 아닙니다: ${target_path}"
  [[ "$(stat -f '%u' "$target_path")" == "0" ]] || fail "root 소유 파일이 아닙니다: ${target_path}"
  local mode
  mode="$(stat -f '%Lp' "$target_path")"
  (( (8#$mode & 8#22) == 0 )) || fail "그룹 또는 다른 사용자가 쓸 수 있는 파일입니다: ${target_path}"
}

verify_hash() {
  local target_path="$1"
  local expected_hash="$2"
  local actual_hash
  actual_hash="$(shasum -a 256 "$target_path" | awk '{print $1}')"
  [[ "$actual_hash" == "$expected_hash" ]] || fail "설치 파일 무결성 검증에 실패했습니다: ${target_path}"
}

verify_secure_root_directory "/Library"
verify_secure_root_directory "/Library/Application Support"
verify_secure_root_directory "/Library/Application Support/BatteryGuard"
verify_secure_root_directory "$assets_dir"
verify_secure_root_file "$assets_dir/battery"
verify_secure_root_file "$assets_dir/smc"
verify_secure_root_file "$assets_dir/Battery-CLI-MIT.txt"
verify_secure_root_file "$assets_dir/Third-Party-Notices.md"
verify_secure_root_file "$assets_dir/battery.sudoers"
verify_hash "$assets_dir/battery" "$expected_battery_hash"
verify_hash "$assets_dir/smc" "$expected_smc_hash"
grep -qF 'BATTERY_CLI_VERSION="v1.3.4"' "$assets_dir/battery" || fail "지원하는 battery CLI v1.3.4가 아닙니다."
verify_secure_root_directory "/Applications/BatteryGuard.app"
codesign --verify --deep --strict "/Applications/BatteryGuard.app" || fail "BatteryGuard 코드 서명 검증에 실패했습니다."

console_user="$(stat -f '%Su' /dev/console)"
[[ -n "$console_user" && "$console_user" != "root" && "$console_user" != "loginwindow" ]] || \
  fail "현재 로그인한 사용자를 확인할 수 없습니다. 로그인한 데스크톱 세션에서 설치하세요."
print -r -- "$console_user" | grep -Eq '^[A-Za-z0-9._-]+$' || fail "지원하지 않는 macOS 사용자 이름입니다."

readonly backup_dir="$(mktemp -d /private/tmp/batteryguard-install-backup.XXXXXX)"
readonly usr_local_existed="$([[ -d "/usr/local" ]] && print 1 || print 0)"
readonly dependency_dir_existed="$([[ -d "$dependency_dir" ]] && print 1 || print 0)"
install_committed=0
sudoers_temp=""

backup_existing_file() {
  local target_path="$1"
  local name="$2"
  if [[ ! -e "$target_path" && ! -L "$target_path" ]]; then
    touch "$backup_dir/.absent-$name"
    return 0
  fi
  [[ -f "$target_path" && ! -L "$target_path" ]] || fail "기존 설치 대상이 일반 파일이 아닙니다: ${target_path}"
  cp -p "$target_path" "$backup_dir/$name"
}

restore_or_remove_file() {
  local target_path="$1"
  local name="$2"
  if [[ -f "$backup_dir/$name" ]]; then
    cp -p "$backup_dir/$name" "$target_path"
  elif [[ -f "$backup_dir/.absent-$name" ]]; then
    rm -f "$target_path"
  fi
}

finish_install() {
  local exit_status=$?
  local rollback_failed=0
  if (( install_committed == 0 )); then
    restore_or_remove_file "$dependency_dir/battery" battery || rollback_failed=1
    restore_or_remove_file "$dependency_dir/smc" smc || rollback_failed=1
    restore_or_remove_file "$dependency_dir/Battery-CLI-MIT.txt" battery-license || rollback_failed=1
    restore_or_remove_file "$dependency_dir/Third-Party-Notices.md" notices || rollback_failed=1
    restore_or_remove_file "$sudoers_file" sudoers || rollback_failed=1
    if [[ "$dependency_dir_existed" == "0" ]]; then
      rmdir "$dependency_dir" 2>/dev/null || true
    fi
    if [[ "$usr_local_existed" == "0" ]]; then
      rmdir "/usr/local" 2>/dev/null || true
    fi
  fi
  [[ -z "$sudoers_temp" ]] || rm -f "$sudoers_temp"
  if (( rollback_failed == 0 )); then
    rm -rf "$backup_dir"
  else
    print -u2 -- "BatteryGuard 설치 복원이 완전하지 않습니다. 백업 보존 위치: ${backup_dir}"
  fi
  return "$exit_status"
}
handle_signal() {
  trap - INT TERM
  exit 130
}
trap finish_install EXIT
trap handle_signal INT TERM

backup_existing_file "$dependency_dir/battery" battery
backup_existing_file "$dependency_dir/smc" smc
backup_existing_file "$dependency_dir/Battery-CLI-MIT.txt" battery-license
backup_existing_file "$dependency_dir/Third-Party-Notices.md" notices
backup_existing_file "$sudoers_file" sudoers

if [[ "$dependency_dir_existed" == "0" ]]; then
  install -d -m 755 -o root -g wheel "$dependency_dir"
fi
verify_secure_root_directory "/usr/local"
verify_secure_root_directory "$dependency_dir"
install -m 755 -o root -g wheel "$assets_dir/battery" "$dependency_dir/battery"
install -m 755 -o root -g wheel "$assets_dir/smc" "$dependency_dir/smc"
install -m 644 -o root -g wheel "$assets_dir/Battery-CLI-MIT.txt" "$dependency_dir/Battery-CLI-MIT.txt"
install -m 644 -o root -g wheel "$assets_dir/Third-Party-Notices.md" "$dependency_dir/Third-Party-Notices.md"
verify_hash "$dependency_dir/battery" "$expected_battery_hash"
verify_hash "$dependency_dir/smc" "$expected_smc_hash"
[[ "$(stat -f '%u:%g:%Lp' "$dependency_dir/battery")" == "0:0:755" ]] || fail "battery CLI 권한 검증에 실패했습니다."
[[ "$(stat -f '%u:%g:%Lp' "$dependency_dir/smc")" == "0:0:755" ]] || fail "SMC 도구 권한 검증에 실패했습니다."
[[ "$(stat -f '%u:%g:%Lp' "$dependency_dir/Battery-CLI-MIT.txt")" == "0:0:644" ]] || fail "battery 라이선스 권한 검증에 실패했습니다."
[[ "$(stat -f '%u:%g:%Lp' "$dependency_dir/Third-Party-Notices.md")" == "0:0:644" ]] || fail "제3자 고지 권한 검증에 실패했습니다."

if [[ ! -d "$sudoers_dir" ]]; then
  install -d -m 755 -o root -g wheel "$sudoers_dir"
fi
verify_secure_root_directory "$sudoers_dir"
sudoers_temp="$(mktemp "${sudoers_dir}/.batteryguard.XXXXXX")"

sed "s/__BATTERYGUARD_USER__/${console_user}/g" "$assets_dir/battery.sudoers" >"$sudoers_temp"
chown root:wheel "$sudoers_temp"
chmod 440 "$sudoers_temp"
visudo -c -f "$sudoers_temp" >/dev/null || fail "sudoers 정책 검증에 실패했습니다."
mv -f "$sudoers_temp" "$sudoers_file"
sudoers_temp=""
chown root:wheel "$sudoers_file"
chmod 440 "$sudoers_file"
# The candidate was validated before replacement. Do not make BatteryGuard's
# transaction depend on unrelated pre-existing files under sudoers.d; another
# app's invalid permissions must not cause this valid policy to be rolled back.
visudo -c -f "$sudoers_file" >/dev/null || fail "설치된 sudoers 정책 검증에 실패했습니다. 설치 변경을 복원합니다."

install_committed=1

exit 0
