#!/bin/zsh

set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin

readonly dependency_dir="/usr/local/co.palokaj.battery"
readonly sudoers_file="/private/etc/sudoers.d/battery"
readonly script_dir="${0:A:h}"
readonly legacy_sudoers_file="${script_dir}/battery-v1.3.4.sudoers"
readonly expected_battery_hash="ce1917ba2176851bf6096f1a343ff9e1306c748e1ee2c5fbe9e37fa3cd45bf04"
readonly expected_smc_hash="e3b4392c966dee700f3e1d6cc3812c0d487954c3d6d77b91f521a9590aadae44"

fail() {
  print -u2 -- "BatteryGuard 설치 중단: $*"
  exit 1
}

[[ "$(id -u)" == "0" ]] || fail "관리자 권한이 필요합니다."
[[ "$(uname -m)" == "arm64" ]] || fail "Apple Silicon Mac만 지원합니다."

os_major="$(sw_vers -productVersion | cut -d. -f1)"
[[ "$os_major" == <-> && "$os_major" -ge 14 ]] || fail "macOS 14 이상이 필요합니다."

verify_secure_root_directory() {
  local target_path="$1"
  [[ -d "$target_path" && ! -L "$target_path" ]] || fail "신뢰할 수 있는 디렉터리가 아닙니다: ${target_path}"
  [[ "$(stat -f '%u' "$target_path")" == "0" ]] || fail "root 소유 디렉터리가 아닙니다: ${target_path}"
  local mode
  mode="$(stat -f '%Lp' "$target_path")"
  (( (8#$mode & 8#22) == 0 )) || fail "그룹 또는 다른 사용자가 쓸 수 있는 디렉터리입니다: ${target_path}"
}

# PackageKit presents the sealed system volume through an installer sandbox.
# Validate the writable destination boundary below instead of the sandboxed
# /usr mount, whose projected ownership is not a reliable host invariant.
if [[ -e "/usr/local" || -L "/usr/local" ]]; then
  verify_secure_root_directory "/usr/local"
fi
if [[ -e "$dependency_dir" || -L "$dependency_dir" ]]; then
  verify_secure_root_directory "$dependency_dir"
fi

if [[ -e "/Applications/BatteryGuard.app" || -L "/Applications/BatteryGuard.app" ]]; then
  [[ -d "/Applications/BatteryGuard.app" && ! -L "/Applications/BatteryGuard.app" ]] || \
    fail "기존 BatteryGuard.app 경로가 일반 앱 디렉터리가 아닙니다."
fi

verify_existing_file() {
  local target_path="$1"
  local expected_hash="$2"
  local display_name="$3"

  [[ -e "$target_path" || -L "$target_path" ]] || return 0
  [[ -f "$target_path" && ! -L "$target_path" ]] || fail "기존 ${display_name}이 일반 파일이 아닙니다: ${target_path}"
  local actual_hash
  actual_hash="$(shasum -a 256 "$target_path" | awk '{print $1}')"
  [[ "$actual_hash" == "$expected_hash" ]] || \
    fail "다른 버전의 ${display_name}이 이미 설치되어 있습니다. 기존 배터리 관리 도구를 안전하게 해제·제거한 뒤 다시 설치하세요."
}

verify_existing_file "$dependency_dir/battery" "$expected_battery_hash" "battery CLI"
verify_existing_file "$dependency_dir/smc" "$expected_smc_hash" "SMC 도구"

if [[ -e "$sudoers_file" || -L "$sudoers_file" ]]; then
  [[ -f "$sudoers_file" && ! -L "$sudoers_file" ]] || fail "기존 battery sudoers 정책이 일반 파일이 아닙니다."
  [[ "$(stat -f '%u:%g:%Lp' "$sudoers_file")" == "0:0:440" ]] || \
    fail "기존 battery sudoers 정책의 소유권 또는 권한이 안전하지 않습니다."
  visudo -c -f "$sudoers_file" >/dev/null || fail "기존 battery sudoers 정책이 유효하지 않습니다."
  if ! grep -qF '# BatteryGuard least-privilege policy' "$sudoers_file"; then
    [[ -f "$legacy_sudoers_file" && ! -L "$legacy_sudoers_file" ]] || \
      fail "검증용 battery CLI v1.3.4 정책이 패키지에 없습니다."
    cmp -s "$sudoers_file" "$legacy_sudoers_file" || \
      fail "다른 배터리 도구의 관리자 권한 정책이 이미 있습니다. 해당 도구의 제어를 안전하게 해제·제거한 뒤 다시 설치하세요."
  fi
fi

if pgrep -x BatteryGuard >/dev/null 2>&1; then
  fail "실행 중인 BatteryGuard를 먼저 정상 종료하세요."
fi

if ps -axo command= | awk -v battery="$dependency_dir/battery" \
  '$1 == "/bin/bash" && $2 == battery && ($3 == "maintain_synchronous" || $3 == "charge" || $3 == "discharge") { found = 1 } END { exit !found }'; then
  fail "기존 Maintain, Top Up 또는 Discharge 작업이 실행 중입니다. 기존 배터리 관리 앱에서 충전 제어를 안전하게 해제한 뒤 다시 설치하세요."
fi

exit 0
